# ── AI Servisleri ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_NEWS_MODEL=gemini-2.0-flash
GEMINI_NEWS_MAX_RETRIES=3

# ── Ollama (yerel fine-tuned model) ────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen-raft-finans

# ── Python Veri Servisi ─────────────────────────────────────────────────────────
PYTHON_SERVICE_URL=http://localhost:8001
CLEAN_MACRO_PATH=python/data/clean_macro.json
# EVDS (TCMB) — fetcher.py, currency_history.py; kod içinde hardcode yok
EVDS_API_KEY=

# ── RAG Bağlamı (isteğe bağlı) ─────────────────────────────────────────────────
RAG_CONTEXT=

# ── Supabase / Postgres ─────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
DATABASE_URL=postgres://postgres:password@db.xxx.supabase.co:5432/postgres?sslmode=require

# ── Auth ────────────────────────────────────────────────────────────────────────
JWT_SECRET=en-az-32-karakter-guclu-rastgele-deger

# ── Pipeline / Cron ─────────────────────────────────────────────────────────────
PIPELINE_MAX_CONCURRENT=3
CRON_INTERVAL_HOURS=6

# ── Haber Servisleri ─────────────────────────────────────────────────────────────
# NewsAPI.org ücretsiz plan: https://newsapi.org/register
NEWSAPI_KEY=

# ── Güvenlik ─────────────────────────────────────────────────────────────────────
# INTERNAL_SECRET tanımlıysa /internal/* rotaları X-Internal-Secret header doğrular.
# Boş bırakılırsa koruma devre dışı (geliştirme modu).
INTERNAL_SECRET=

# ── Sunucu ───────────────────────────────────────────────────────────────────────
PORT=8080
